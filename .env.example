# Configuración del Bot de Discord
TOKEN=MTUyNzEwNTA1MDUwODI2NzY0MA.G2XRZ-.bUaB300mvBfhqgiunMe3WFo2ZMWNNg_ciZDhDo

# Opcional: Configuración de Spotify
# Para activar el soporte de Spotify, pon SPOTIFY_ENABLED=true y proporciona tus credenciales
# Consigue tus credenciales en: https://developer.spotify.com/dashboard/applications
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=tu_client_id_de_spotify_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_de_spotify_aqui

# Configuración del Servidor Lavalink
# Si los tres valores de abajo están configurados, BeatDock se conecta a tu servidor Lavalink..
# Si se dejan vacíos o comentados, BeatDock usa automáticamente servidores públicos de Lavalink gratuitos..
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Opcional: Configuración de Idioma
DEFAULT_LANGUAGE=es

# Opcional: Configuración de Desconexión
QUEUE_EMPTY_DESTROY_MS=30000
EMPTY_CHANNEL_DESTROY_MS=60000

# Opcional: Configuración de Permisos
# Lista de IDs de roles separados por coma que pueden usar el bot
# Déjalo vacío para permitir que todos usen el bot
# Ejemplo: ALLOWED_ROLES=123456789012345678,234567890123456789
ALLOWED_ROLES=

# Opcional: Configuración de Audio
DEFAULT_VOLUME=100

# Opcional: Configuración de Reproducción Automática
# Pon en true para activar el autoplay por defecto cuando empiece a sonar música (por defecto: false)
#AUTOPLAY_DEFAULT=false

# Opcional: Configuración de Plataforma de Búsqueda Predeterminada
# Plataforma de búsqueda predeterminada para las consultas de los usuarios (por defecto: ytmsearch)
# Plataformas soportadas incluyen: ytsearch (YouTube), ytmsearch (YouTube Music), y más según tu configuración de Lavalink.
# Opciones de plataforma: https://lc4.gitbook.io/lavalink-client/docs/other-types/searchplatform/lavalinksearchplatform
DEFAULT_SEARCH_PLATFORM=ytmsearch

# Opcional: Configuración de Registro (Logs)
# Nivel de registro: debug, info, warn, error (por defecto: info)
#LOG_LEVEL=info

# Opcional: Configuración de Reconexión de Lavalink
# Número máximo de intentos de reconexión (por defecto: 10)
LAVALINK_MAX_RECONNECT_ATTEMPTS=10

# Retraso base para el backoff exponencial en milisegundos (por defecto: 1000)
LAVALINK_BASE_DELAY_MS=1000

# Retraso máximo para el backoff exponencial en milisegundos (por defecto: 30000)
LAVALINK_MAX_DELAY_MS=30000

# Intervalo de verificación de salud (health check) en milisegundos (por defecto: 30000)
LAVALINK_HEALTH_CHECK_INTERVAL_MS=30000

# Reiniciar los intentos de reconexión después de esta cantidad de minutos (por defecto: 5)
LAVALINK_RESET_ATTEMPTS_AFTER_MINUTES=5
